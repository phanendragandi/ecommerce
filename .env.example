# Frontend (Next.js / Vercel) — safe-to-expose values only.
# Copy to .env.local (or .env) and fill in. NEVER put service-role or
# Razorpay secrets here — those live only in server/.env.

NEXT_PUBLIC_CURRENCY=$
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
